<?xml version="1.0" encoding="utf-8"?>
<!-- Splash sizing is intentionally independent from the launcher icon. The nested
     foreground automatically resolves to black in light mode and white in dark mode. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="30dp"
        android:left="30dp"
        android:right="30dp"
        android:top="30dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
