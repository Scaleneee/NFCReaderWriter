<?xml version="1.0" encoding="utf-8"?>
<!-- Scale both day/night transparent foregrounds down slightly and keep them centered. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="11dp"
        android:left="11dp"
        android:right="11dp"
        android:top="11dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
