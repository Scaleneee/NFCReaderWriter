<?xml version="1.0" encoding="utf-8"?>
<!-- Display both day/night transparent foregrounds at 85% of their previous size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="17.45dp"
        android:left="17.45dp"
        android:right="17.45dp"
        android:top="17.45dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
